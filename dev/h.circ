<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project source="3.8.0" version="1.0">
  <lib desc="#Wiring" name="0"/>
  <lib desc="#Gates" name="1"/>
  <lib desc="#Plexers" name="2"/>
  <lib desc="#Arithmetic" name="3"/>
  <lib desc="#Memory" name="4"/>
  <lib desc="#I/O" name="5"/>
  <lib desc="#TTL" name="A"/>
  <lib desc="#TCL" name="7"/>
  <lib desc="#Base" name="8"/>
  <lib desc="#BFH-Praktika" name="9"/>
  <lib desc="#Input/Output-Extra" name="B"/>
  <lib desc="#Soc" name="C"/>
  <main name="main"/>
  <options>
    <a name="showgrid" val="true"/>
    <a name="simulate" val="true"/>
    <a name="showghosts" val="true"/>
    <a name="zoom" val="1.0"/>
  </options>
  <mappings>
    <tool lib="8" map="Button2" name="Poke Tool"/>
    <tool lib="8" map="Button3" name="Menu Tool"/>
    <tool lib="8" map="Ctrl Button1" name="Menu Tool"/>
  </mappings>
  <toolbar>
    <tool lib="8" name="Poke Tool"/>
    <tool lib="8" name="Edit Tool"/>
    <tool lib="8" name="Wiring Tool"/>
    <tool lib="8" name="Text Tool"/>
    <sep/>
    <tool lib="0" name="Pin">
      <a name="tristate" val="false"/>
    </tool>
    <tool lib="0" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
    </tool>
    <sep/>
    <tool lib="1" name="NOT Gate"/>
    <tool lib="1" name="AND Gate"/>
    <tool lib="1" name="OR Gate"/>
    <tool lib="1" name="XOR Gate"/>
    <tool lib="1" name="NAND Gate"/>
    <tool lib="1" name="NOR Gate"/>
    <sep/>
    <tool lib="4" name="D Flip-Flop"/>
    <tool lib="4" name="Register"/>
  </toolbar>
  <circuit name="main">
    <a name="circuit" val="main"/>
    <a name="appearance" val="classic"/>
<comp lib="0" loc="(100,100)" name="Pin"><a name="label" val="A"/><a name="tristate" val="false"/></comp>
<comp lib="1" loc="(200,100)" name="NOT Gate"></comp>
<wire from="(100,100)" to="(170,100)"/>
<comp lib="0" loc="(260,100)" name="Tunnel"><a name="label" val="t"/><a name="facing" val="west"/></comp>
<wire from="(200,100)" to="(260,100)"/>
<comp lib="0" loc="(300,200)" name="Tunnel"><a name="label" val="t"/></comp>
<comp lib="1" loc="(400,200)" name="Buffer"></comp>
<wire from="(300,200)" to="(380,200)"/>
<comp lib="0" loc="(500,200)" name="Pin"> <a name="facing" val="west"/><a name="label" val="Y"/><a name="output" val="true"/></comp>
<wire from="(400,200)" to="(500,200)"/>
  </circuit>
</project>
